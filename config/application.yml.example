# EC2 HTTPS 운영: cp application-prod.yml.example config/application.yml 후 값 입력
# BACKEND_URL, FRONTEND_URL 은 반드시 https:// 로 시작

spring:
  application.name: localpath

  datasource:
    url: jdbc:mysql://my-db:3306/mydb?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
    username: root
    password: YOUR_MYSQL_PASSWORD
    driver-class-name: com.mysql.cj.jdbc.Driver

  jpa:
    show-sql: false
    hibernate:
      ddl-auto: update

  docker:
    compose:
      enabled: false

  jwt:
    accessToken-expire-length: 600000
    refresh-expire-length: 2592000000
    secret: YOUR_JWT_SECRET

  security:
    oauth2:
      client:
        registration:
          kakao:
            client-name: kakao
            client-id: YOUR_KAKAO_REST_API_KEY
            client-secret: YOUR_KAKAO_CLIENT_SECRET
            redirect-uri: https://api.example.com/login/oauth2/code/kakao
            authorization-grant-type: authorization_code
            client-authentication-method: client_secret_post
            scope:
              - profile_nickname
              - account_email

        provider:
          kakao:
            authorization-uri: https://kauth.kakao.com/oauth/authorize
            token-uri: https://kauth.kakao.com/oauth/token
            user-info-uri: https://kapi.kakao.com/v2/user/me
            user-name-attribute: id

server:
  forward-headers-strategy: framework

localpath:
  frontend:
    url: https://www.example.com
  cors:
    allowed-origins:
      - https://www.example.com
  auth:
    cookie-secure: true
    cookie-same-site: None
